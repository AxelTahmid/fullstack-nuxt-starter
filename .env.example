PORT=3000
NODE_ENV=development

NUXT_PUBLIC_APP_NAME="Fullstack Starter"
NUXT_PUBLIC_BASE_URL="http://localhost:3000"
NUXT_SESSION_PASSWORD="change-me-to-a-long-random-string-with-at-least-32-characters"
NUXT_SESSION_COOKIE_SECURE=false

AUTH_MAGIC_LINK_TTL_MINUTES=20

DB_HOST=localhost
DB_PORT=5432
DB_USER=starter
DB_PASSWORD=starter
DB_NAME=starter
DB_SSL=false
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter

# SMTP Configuration
# Local host dev uses Mailpit's published port. Docker Compose overrides this to `mailpit`.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_POOL=false
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT=120000
SMTP_SOCKET_TIMEOUT=600000
SMTP_TLS_REJECT_UNAUTHORIZED=false
SMTP_USER=
SMTP_PASS=

# Production SMTP: set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, and keep TLS verification enabled.
MAILER_DEFAULT_FROM="SupplyKey <noreply@supplykey.local>"
MAILER_DEFAULT_REPLY_TO=""
MAILER_DEFAULT_PRIORITY=normal

PGBOSS_APP_NAME=fullstack_starter_queue
PGBOSS_SCHEMA=queue
PGBOSS_MIGRATE=true
PGBOSS_MAX_CONN=10

SAGE300_API_BASE_URL=http://192.168.0.5/Sage300WebApi
SAGE300_USERNAME=
SAGE300_PASSWORD=
SAGE300_API_VERSION=
SAGE300_TENANT=
SAGE300_COMPANY=
